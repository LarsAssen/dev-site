# Enquiry form email delivery.
# Set these in Netlify under Site configuration → Environment variables.
# They are read by netlify/functions/enquiry.ts. Nothing here is bundled into
# the static site — these values never reach the browser.

# Required. Create at https://resend.com → API Keys.
# Without it the function returns 503 and the forms tell the visitor to email
# directly rather than pretending the message was sent.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — both default to websites@lars-assen.com.
# ENQUIRY_FROM must be on a domain verified in Resend or sending is refused
# with 403. Sending from outside the Google Workspace is the point: it makes an
# enquiry genuinely inbound mail, so Gmail delivers it to the inbox instead of
# deduplicating it into Sent the way it did when Workspace sent to its own alias.
ENQUIRY_TO=websites@lars-assen.com
ENQUIRY_FROM=websites@lars-assen.com
