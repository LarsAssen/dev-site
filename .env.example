# Enquiry form email delivery.
# Set these in Netlify under Site configuration → Environment variables.
# They are read by netlify/functions/enquiry.ts. Nothing here is bundled into
# the static site — these values never reach the browser.

# Required. The Google Workspace address that authenticates and sends.
SMTP_USER=websites@lars-assen.com

# Required. A Google APP PASSWORD for that account, not the login password.
# Generate at https://myaccount.google.com/apppasswords while signed in as
# SMTP_USER. 2-Step Verification must be on for that account first, and your
# Workspace admin must not have App Passwords blocked.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional — the defaults below are what Gmail expects.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Optional. ENQUIRY_TO defaults to websites@lars-assen.com.
# ENQUIRY_FROM defaults to SMTP_USER; Gmail rewrites it to the authenticated
# account anyway unless it is a verified "send mail as" alias, so leaving it
# unset is usually correct.
ENQUIRY_TO=websites@lars-assen.com
